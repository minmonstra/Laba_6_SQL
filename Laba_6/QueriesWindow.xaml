<Window x:Class="Laba_6.QueriesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SQL-запросы" Height="680" Width="1050"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Список готовых запросов из Database/queries.sql -->
        <ListBox x:Name="LstQueries" DisplayMemberPath="Title" Background="#FADADD"
                 SelectionChanged="LstQueries_SelectionChanged"/>

        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="170"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="TxtDescription" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,6" FontStyle="Italic"/>

            <TextBox x:Name="TxtSql" Grid.Row="1" AcceptsReturn="True" AcceptsTab="True"
                     FontFamily="Consolas" FontSize="13" VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Auto"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                <Button Content="Выполнить" Width="110" Padding="6,4" Click="BtnRun_Click"
                        Background="#B3446C" Foreground="White"/>
                <Button Content="Экспорт в CSV" Width="110" Padding="6,4" Margin="8,0,0,0" Click="BtnExport_Click"/>
                <TextBlock Text="Разрешены только SELECT / WITH (соединение открыто в режиме «только чтение»)"
                           Margin="14,0,0,0" VerticalAlignment="Center" Foreground="#555555"/>
            </StackPanel>

            <DataGrid x:Name="DgResult" Grid.Row="3" AutoGenerateColumns="True" IsReadOnly="True"
                      CanUserAddRows="False" Background="#FADADD"/>

            <TextBlock x:Name="TxtStatus" Grid.Row="4" Margin="0,6,0,0"/>
        </Grid>
    </Grid>
</Window>
