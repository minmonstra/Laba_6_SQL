<Window x:Class="Laba_6.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Laba_6"
        mc:Ignorable="d"
        Title="Умный дом: квартиры и комнаты (SQLite)"
        Height="700" Width="1200">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>


        <Menu Grid.ColumnSpan="2" Background="#B3446C">
            <MenuItem Header="Квартира" Height="40" Foreground="#FADADD">
                <MenuItem Header="Добавить квартиру" Foreground="Black" Click="AddApartment_Click"/>
                <MenuItem Header="Удаление квартиры" Foreground="Black" Click="DeleteApartment_Click" />
            </MenuItem>
            <MenuItem Header="Комната" Height="40" Foreground="#FADADD">
                <MenuItem Header="Добавить комнату" Foreground="Black" Click="AddRoom_Click"/>
                <MenuItem Header="Удаление комнаты" Foreground="Black" Click="DeleteRoom_Click"/>
            </MenuItem>
            <MenuItem Header="Сервис" Height="40" Foreground="#FADADD">
                <MenuItem Header="SQL-запросы..." Foreground="Black" Click="OpenQueries_Click"/>
                <MenuItem Header="Обновить данные" Foreground="Black" Click="Refresh_Click"/>
                <Separator/>
                <MenuItem Header="Сбросить БД к тестовым данным" Foreground="Black" Click="ResetDatabase_Click"/>
            </MenuItem>
        </Menu>

        <!-- Панель поиска и фильтра (параметры уходят в SQL-запрос WHERE ... LIKE) -->
        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,8,0,8">
            <TextBlock Text="Поиск комнаты по названию:" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="TxtSearch" Width="220" TextChanged="TxtSearch_TextChanged"/>
            <CheckBox x:Name="ChkOnlySelected" Content="Только комнаты выбранной квартиры"
                      Margin="20,0,0,0" VerticalAlignment="Center" Click="ChkOnlySelected_Click"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="DgApartments"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  Margin="0,0,5,10"
                  Background="#FADADD"
                  SelectionChanged="DgApartments_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="Номер квартиры" Binding="{Binding Number, ValidatesOnExceptions=True}" Width="120"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <DataGrid Grid.Column="1" x:Name="DgRooms"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  SelectionMode="Single"
                  Grid.Row="2"
                  Margin="5,0,0,10"
                  SelectionChanged="DgRooms_SelectionChanged"
                  Background="#FADADD">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
                <DataGridTextColumn Header="ID квартиры" Binding="{Binding ApartId, ValidatesOnExceptions=True}" Width="80"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name, ValidatesOnExceptions=True}" Width="150"/>
                <DataGridTextColumn Header="Площадь, м²" Binding="{Binding Area, ValidatesOnExceptions=True}" Width="100"/>
                <DataGridTextColumn Header="Температура, °C" Binding="{Binding Temperature, ValidatesOnExceptions=True}" Width="110"/>
                <DataGridCheckBoxColumn Header="Свет включен" Binding="{Binding IsLight}" Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Строка состояния: статистика из SQL-запроса с агрегатными функциями -->
        <StatusBar Grid.Row="3" Grid.ColumnSpan="2" Background="#FADADD">
            <StatusBarItem>
                <TextBlock x:Name="TxtStats" Text="Загрузка..."/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="TxtSelected"/>
            </StatusBarItem>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock x:Name="TxtDbPath" Foreground="#555555"/>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
